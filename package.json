{
  "name": "checklist-bridge",
  "displayName": "Checklist Bridge for Claude Code",
  "description": "Each Claude Code chat gets its own checklist in VS Code for the things you do by hand and the decisions you make later. Tick tasks, answer questions, add notes and screenshots, and share them with Claude when you're ready.",
  "version": "0.4.5",
  "publisher": "Akshat270",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:checklistBridge.checklist"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "checklistBridge",
          "title": "Claude checklists",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "checklistBridge": [
        {
          "id": "checklistBridge.list",
          "name": "Checklists"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "checklistBridge.list",
        "when": "!checklistBridge.connected",
        "contents": "Claude Code isn't connected yet. Checklist Bridge connects on its own when VS Code starts; if that didn't work, click below.\n[Connect Claude Code](command:checklistBridge.connect)\nNo Claude Code yet? [Install it](https://code.claude.com/docs/en/overview), then click Connect.\n[Getting started](command:checklistBridge.gettingStarted)"
      },
      {
        "view": "checklistBridge.list",
        "when": "checklistBridge.connected",
        "contents": "Connected to Claude Code. Start a new Claude chat; when Claude needs you to do something by hand or make a decision, its checklist appears here.\n[Open an example checklist](command:checklistBridge.demo)\n[Getting started](command:checklistBridge.gettingStarted)"
      }
    ],
    "commands": [
      {
        "command": "checklistBridge.connect",
        "title": "Connect Claude Code",
        "category": "Checklist Bridge",
        "icon": "$(plug)"
      },
      {
        "command": "checklistBridge.disconnect",
        "title": "Disconnect Claude Code",
        "category": "Checklist Bridge"
      },
      {
        "command": "checklistBridge.setupClaude",
        "title": "Make every Claude Code chat use checklists",
        "category": "Checklist Bridge"
      },
      {
        "command": "checklistBridge.removeClaudeSetup",
        "title": "Undo Claude Code setup",
        "category": "Checklist Bridge"
      },
      {
        "command": "checklistBridge.startClaudeChannels",
        "title": "Start Claude with Send now",
        "category": "Checklist Bridge",
        "icon": "$(terminal)"
      },
      {
        "command": "checklistBridge.copySetup",
        "title": "Copy Claude Code setup command",
        "category": "Checklist Bridge"
      },
      {
        "command": "checklistBridge.demo",
        "title": "Open an example checklist",
        "category": "Checklist Bridge"
      },
      {
        "command": "checklistBridge.pick",
        "title": "Show a checklist…",
        "category": "Checklist Bridge"
      },
      {
        "command": "checklistBridge.showAll",
        "title": "Show all checklists",
        "category": "Checklist Bridge",
        "icon": "$(eye)"
      },
      {
        "command": "checklistBridge.hideAll",
        "title": "Hide all checklists",
        "category": "Checklist Bridge",
        "icon": "$(eye-closed)"
      },
      {
        "command": "checklistBridge.show",
        "title": "Show",
        "icon": "$(eye)"
      },
      {
        "command": "checklistBridge.hide",
        "title": "Hide",
        "icon": "$(eye-closed)"
      },
      {
        "command": "checklistBridge.close",
        "title": "Close checklist",
        "icon": "$(close)"
      },
      {
        "command": "checklistBridge.toggle",
        "title": "Show or hide checklist"
      },
      {
        "command": "checklistBridge.checkForUpdates",
        "title": "Check for updates",
        "category": "Checklist Bridge"
      },
      {
        "command": "checklistBridge.gettingStarted",
        "title": "Getting started",
        "category": "Checklist Bridge"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "checklistBridge.showAll",
          "when": "view == checklistBridge.list",
          "group": "navigation@1"
        },
        {
          "command": "checklistBridge.hideAll",
          "when": "view == checklistBridge.list",
          "group": "navigation@2"
        },
        {
          "command": "checklistBridge.connect",
          "when": "view == checklistBridge.list",
          "group": "z@1"
        },
        {
          "command": "checklistBridge.demo",
          "when": "view == checklistBridge.list",
          "group": "z@2"
        },
        {
          "command": "checklistBridge.startClaudeChannels",
          "when": "view == checklistBridge.list",
          "group": "z@3"
        }
      ],
      "view/item/context": [
        {
          "command": "checklistBridge.show",
          "when": "view == checklistBridge.list && viewItem == checklist.hidden",
          "group": "inline@1"
        },
        {
          "command": "checklistBridge.hide",
          "when": "view == checklistBridge.list && viewItem == checklist.shown",
          "group": "inline@1"
        },
        {
          "command": "checklistBridge.close",
          "when": "view == checklistBridge.list",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "checklistBridge.show",
          "when": "false"
        },
        {
          "command": "checklistBridge.hide",
          "when": "false"
        },
        {
          "command": "checklistBridge.close",
          "when": "false"
        },
        {
          "command": "checklistBridge.toggle",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Checklist Bridge",
      "properties": {
        "checklistBridge.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Install new versions automatically from the update repo, then offer a reload.",
          "scope": "application"
        },
        "checklistBridge.updateRepo": {
          "type": "string",
          "default": "Akshat270/checklist-bridge",
          "description": "Public GitHub repo (owner/name) whose main branch has latest.json and the .vsix files.",
          "scope": "application"
        },
        "checklistBridge.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Connect Claude Code to your checklists automatically when VS Code starts (runs `claude mcp add` for you).",
          "scope": "application"
        },
        "checklistBridge.claudePath": {
          "type": "string",
          "default": "",
          "description": "Full path to the `claude` command, if Checklist Bridge can't find it on its own.",
          "scope": "machine"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Checklist Bridge",
        "description": "Your checklist for the things Claude needs you to do by hand, and the decisions you can make later.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect Claude Code",
            "description": "Happens automatically when VS Code starts.\n[Connect Claude Code](command:checklistBridge.connect)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:checklistBridge.connected"
            ]
          },
          {
            "id": "chat",
            "title": "Start a new Claude chat",
            "description": "Claude Code picks up new tools when a chat starts.",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onContext:checklistBridge.claudeUsed"
            ]
          },
          {
            "id": "everychat",
            "title": "Make every chat use it (optional)",
            "description": "So Claude uses your checklist without being asked.\n[Set it up](command:checklistBridge.setupClaude)",
            "media": {
              "markdown": "media/walkthrough/everychat.md"
            },
            "completionEvents": [
              "onContext:checklistBridge.everyChat"
            ]
          },
          {
            "id": "example",
            "title": "See an example",
            "description": "Try ticking, noting and sharing.\n[Open an example checklist](command:checklistBridge.demo)",
            "media": {
              "markdown": "media/walkthrough/example.md"
            },
            "completionEvents": [
              "onCommand:checklistBridge.demo"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "release": "python3 scripts/release.py",
    "test": "node test/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0",
    "playwright": "^1.48.0"
  },
  "icon": "media/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "mcp",
    "checklist",
    "ai agent",
    "human in the loop",
    "decisions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Akshat270/checklist-bridge"
  },
  "homepage": "https://github.com/Akshat270/checklist-bridge#readme",
  "bugs": {
    "url": "https://github.com/Akshat270/checklist-bridge/issues"
  },
  "galleryBanner": {
    "color": "#1f1f2e",
    "theme": "dark"
  }
}
